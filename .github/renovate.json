{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>cloud-gouv/renovate-config",
    "schedule:weekly"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "dependencyDashboard": true,
  "nix": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "separateMajorMinor": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "matchManagers": [
        "github-actions",
        "nix"
      ],
      "groupName": "CI and Nix inputs"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "Container images"
    }
  ]
}
